# Copy to .env and adjust. All settings are optional — sensible dev defaults
# are baked into backend/app/config.py. Every variable here is a *setting*,
# never a secret you'd need for the AI pipeline — no AI API keys exist in
# this project because no paid AI API is ever called. See docs/AI_MODEL_LICENSE.md.

# --- Environment ---
# Leave unset (defaults to "development") for local dev and the test suite.
# Set to "production" in a real deployment's environment -- this makes
# startup refuse to run if AITRYON_JWT_SECRET_KEY or AITRYON_DATABASE_URL
# below are still at their insecure local-dev defaults (see
# backend/app/config.py's _refuse_insecure_production_secrets).
# AITRYON_ENVIRONMENT=production

# --- AI model ---
AITRYON_WEIGHTS_DIR=ai/models/fashn-vton-1.5
AITRYON_DEVICE=cpu
AITRYON_DEFAULT_NUM_TIMESTEPS=30
AITRYON_MIN_NUM_TIMESTEPS=4
AITRYON_MAX_NUM_TIMESTEPS=50
# How long a single generation may run before the provider gives up
# waiting and reports failure. NOT a true hard kill of the underlying
# computation -- see backend/app/providers/selfhosted.py's module
# docstring. Generous default covers this project's CPU-dev worst case; a
# real GPU deployment (seconds per generation) should set this much lower.
AITRYON_INFERENCE_TIMEOUT_SECONDS=3600
# How long a caller waits to acquire the provider's internal lock before
# giving up -- see the same docstring for why this exists alongside the
# timeout above.
AITRYON_PROVIDER_LOCK_ACQUIRE_TIMEOUT_SECONDS=3600
# How long a job may sit in status=processing (e.g. the server process was
# killed mid-generation) before the recovery sweep
# (backend/app/services/job_recovery.py) marks it failed.
AITRYON_STALE_JOB_THRESHOLD_MINUTES=120

# --- Storage ---
AITRYON_STORAGE_DIR=backend/storage

# --- Upload limits ---
AITRYON_MAX_UPLOAD_SIZE_MB=10
AITRYON_MAX_IMAGE_DIMENSION_PX=4096
# Hard cap on the raw HTTP request body as a whole (25 MiB default),
# enforced before any upload parsing/decoding happens -- a different,
# earlier layer than the two settings above. See
# backend/app/core/body_size_limit.py and docs/ENVIRONMENT.md. If a
# reverse proxy sits in front of this app in production, give it its own
# aligned body-size limit too (e.g. nginx's client_max_body_size).
AITRYON_MAX_REQUEST_BODY_BYTES=26214400

# --- Rate limiting (raw abuse protection; real per-plan quotas come later) ---
AITRYON_RATE_LIMIT_MAX_REQUESTS=20
AITRYON_RATE_LIMIT_WINDOW_SECONDS=3600

# Global cap (every user/IP combined) on pending/processing try-on jobs at
# once -- a different question from the per-identity limit above, since
# the self-hosted provider only ever runs one generation at a time no
# matter how many jobs exist. See app/services/capacity_service.py.
AITRYON_MAX_ACTIVE_TRYON_JOBS=10
# Product image extraction is classical CV (milliseconds), not the AI model
# (minutes) — a separate, far more generous limit reflects that.
AITRYON_EXTRACTION_RATE_LIMIT_MAX_REQUESTS=60
AITRYON_EXTRACTION_RATE_LIMIT_WINDOW_SECONDS=600
# Product URL extraction makes an outbound request to a site the caller
# chooses — tighter than the pure-image endpoint above.
AITRYON_URL_EXTRACTION_RATE_LIMIT_MAX_REQUESTS=20
AITRYON_URL_EXTRACTION_RATE_LIMIT_WINDOW_SECONDS=600
# Auth (login/signup): a higher-value target for automated credential-
# stuffing/brute-force than the limits above, so it's deliberately tighter.
# Login uses BOTH a per-IP and a per-account(email) limit — see
# backend/app/api/auth.py for why either alone can be bypassed.
AITRYON_AUTH_LOGIN_IP_RATE_LIMIT_MAX_REQUESTS=10
AITRYON_AUTH_LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=900
AITRYON_AUTH_LOGIN_ACCOUNT_RATE_LIMIT_MAX_REQUESTS=5
AITRYON_AUTH_LOGIN_ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=900
AITRYON_AUTH_SIGNUP_RATE_LIMIT_MAX_REQUESTS=5
AITRYON_AUTH_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
# Forgot-password gets its own dual per-IP + per-email limit, same shape as
# login's above -- see backend/app/api/auth.py for why.
AITRYON_AUTH_FORGOT_PASSWORD_IP_RATE_LIMIT_MAX_REQUESTS=5
AITRYON_AUTH_FORGOT_PASSWORD_IP_RATE_LIMIT_WINDOW_SECONDS=3600
AITRYON_AUTH_FORGOT_PASSWORD_EMAIL_RATE_LIMIT_MAX_REQUESTS=3
AITRYON_AUTH_FORGOT_PASSWORD_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600

# --- CORS: comma-would-not-work-with-pydantic-settings-list, set as JSON array ---
# AITRYON_CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---
# The default below matches docs/DEVELOPMENT.md's local PostgreSQL setup.
# MUST be overridden for any shared/production deployment.
AITRYON_DATABASE_URL=postgresql+psycopg2://postgres:devpassword@localhost:5432/aitryon

# --- Auth ---
# MUST be a long random value outside local dev — generate one with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`.
AITRYON_JWT_SECRET_KEY=dev-only-insecure-secret-change-me
AITRYON_JWT_EXPIRE_MINUTES=10080

# --- Privacy: how long an unsaved result image is kept before deletion ---
AITRYON_UNSAVED_RESULT_TTL_HOURS=24

# --- Password reset ---
# How long a POST /api/auth/forgot-password reset link stays valid.
AITRYON_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# The frontend origin a reset email's link points to. Override this for any
# deployment where the frontend isn't at localhost:5173 -- otherwise every
# emailed reset link points at the wrong place.
AITRYON_FRONTEND_BASE_URL=http://localhost:5173
