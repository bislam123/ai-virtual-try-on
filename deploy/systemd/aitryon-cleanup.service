# Runs backend/scripts/cleanup_expired_results.py once and exits -- the
# "smallest reliable mechanism" chosen for scheduling it (see
# docs/DEPLOYMENT.md section 11): a systemd timer + oneshot service is the
# natural fit alongside aitryon-backend.service already using systemd,
# needs no extra package (unlike e.g. a container-scheduler CronJob,
# which only applies if this is actually deployed on an orchestrator),
# and gets free logging/failure-alerting via `systemctl status`/
# `journalctl -u aitryon-cleanup` and the unit's own exit-code handling
# below -- cron is an equally valid, slightly more minimal alternative
# if the host doesn't otherwise use systemd; docs/DEPLOYMENT.md documents
# both.
#
# The script itself already does all three required things in one run
# (see its own module docstring): stale-PROCESSING-job recovery, expired-
# unsaved-result + leftover-temp-file deletion, and expired/used
# password-reset-token cleanup. Exit code 0 = clean sweep, 1 = at least
# one individual job's cleanup failed (OnFailure below can be pointed at
# a systemd alert unit if the host has one; not configured here, since
# alerting infrastructure is outside this application's own scope).

[Unit]
Description=AI Try-On periodic cleanup sweep (stale jobs, expired results, expired reset tokens)

[Service]
Type=oneshot
User=aitryon
Group=aitryon
WorkingDirectory=/opt/aitryon
EnvironmentFile=/etc/aitryon/backend.env
ExecStart=/opt/aitryon/ai/.venv/bin/python backend/scripts/cleanup_expired_results.py

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aitryon/storage
