{
  "manifest_version": 3,
  "name": "AI Try-On — Try It On",
  "version": "0.1.0",
  "description": "Adds a Try It On button to shopping product pages that opens AI Try-On with the product already loaded.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
